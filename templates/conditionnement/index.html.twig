{% extends 'base.html.twig' %}

{% block title %}Conditionnements
{% endblock %}

{% block body %}
	<div class="col-md-7 contenu-blanc">

		<h1>
			{% if lesConditionnements | length == 0 %}
				Il n'y a pas de conditionnement
			{% elseif lesConditionnements | length == 1%}
				La conditionnement
			{% else %}
				Les
				<span>
					{{  lesConditionnements | length }}
				</span>
				conditionnements
			{% endif %}
		</h1>
		{{ include('messages.html.twig') }}
		<div class="contenu">
			<table class="table table-striped table-advance table-hover">
				<thead>
					<tr class="bg-entete">
						<th>Identifiant</th>
						<th>Libellé</th>
						<th>Unité de mesure</th>
                        <th>Valeur</th>
                        <th>Nombre de produits</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					<!-- formulaire pour ajouter une nouvelle conditionnement-->
					<tr>
						{{ form_start(formCreation) }}
						<td class="col-md-1">Nouveau</td>
						<td class="col-md-2">{{ form_widget(formCreation.libelle, {'attr': {'class': 'col-md-12'}}) }}
							{{ form_errors(formCreation.libelle) }}</td>
                        <td class="col-md-1">{{ form_widget(formCreation.mesure, {'attr': {'class': 'col-md-12'}}) }}
							{{ form_errors(formCreation.mesure) }}</td>
                        <td class="col-md-1">{{ form_widget(formCreation.valeur, {'attr': {'class': 'col-md-12'}}) }}
							{{ form_errors(formCreation.valeur) }}</td>
                        <td class="col-md-2"></td>
						<td class="col-md-2">
							<button class="btn btn-primary btn-sm" type="submit" formaction="{{ path('app_conditionnement_ajouter') }}" title="Enregistrer nouvelle conditionnement" onclick="windows.location.reload()">
								<i class="fa fa-save"></i>
								Enregistrer</button>
							<button class="btn btn-info btn-sm" type="reset" title="Effacer la saisie">
								<i class="fa fa-eraser"></i>
								Annuler
							</button>
						</td>
						{# Ceci va générer le champ CSRF #}
						{{ form_rest(formCreation) }}
						{{ form_end(formCreation) }}
					</tr>
					{% for key, conditionnement in lesConditionnements %}
						<tr>
							{% if conditionnement.id != idConditionnementModif %}

								<td>{{ conditionnement.id }}</td>
								<td>{{ conditionnement.libelle }}</td>
                                <td>{{ conditionnement.mesure }}</td>
                                <td>{{ conditionnement.valeur }}</td>
                                <td>{{ conditionnement.getLesProduits|length }}</td>
								<!-- formulaire pour demander la modification ou la suppression -->
								<td>
									<form>
										<input type="hidden" name="page" value="{{ app.request.query.get('page', 1) }}">

										<button type="submit" class="btn btn-primary btn-sm" formaction="{{ path('app_conditionnement_demandermodification', {'id' : conditionnement.id }) }}" title="Modifier" onclick="windows.location.reload()">
											<i class="fa fa-pencil"></i>
											Modifier
										</button>

										<button class="btn btn-danger btn-sm" type="submit" formaction="{{ path('app_conditionnement_supprimer', {'id' : conditionnement.id }) }}" title="Supprimer" onclick="return confirm('Voulez-vous vraiment supprimer cette conditionnement ?');">
											<i class="fa fa-trash-o "></i>
											Supprimer
										</button>

										<input type="hidden" name="_token" value="{{ csrf_token('action-item' ~ conditionnement.id) }}">
									</form>
								</td>

							{% else %}

								<!-- formulaire pour modifier une conditionnement -->
								{{ form_start(formModification) }}
								<td>{{ conditionnement.id }}</td>
								<td>{{ form_widget(formModification.libelle, {'attr': {'class': 'col-md-12'}}) }}
									{{ form_errors(formModification.libelle) }}</td>
                                <td>{{ form_widget(formModification.mesure, {'attr': {'class': 'col-md-12'}}) }}
									{{ form_errors(formModification.mesure) }}</td>
                                <td>{{ form_widget(formModification.valeur, {'attr': {'class': 'col-md-12'}}) }}
									{{ form_errors(formModification.valeur) }}</td>
                                <td>{{ conditionnement.getLesProduits|length }}</td>

								<td class="col-md-4">
									<button class="btn btn-primary btn-sm" type="submit" formaction="{{ path('app_conditionnement_modifier', { 'id' : conditionnement.id, 'page': app.request.query.get('page', 1) }) }}" title="Enregistrer" onclick="windows.location.reload()">
										<i class="fa fa-save"></i>
										Enregistrer
									</button>
									<button class="btn btn-info btn-sm" type="reset" title="Effacer la saisie">
										<i class="fa fa-eraser"></i>
										Effacer</button>
									<button class="btn btn-warning btn-sm" type="button" title="Annuler" onclick="windows.location.reload()">
										<a href="{{ path('app_conditionnement', {'page': app.request.query.get('page', 1)}) }}">
											<i class="fa fa-undo"></i>
											Annuler
										</a>
									</button>
								</td>
								{# Ceci va générer le champ CSRF #}
								{{ form_rest(formModification) }}
								{{ form_end(formModification) }}
							{% endif %}

						</tr>
					{% endfor %}

				</tbody>
			</table>
			<div class="navigation">
				{{ knp_pagination_render(lesConditionnements) }}
			</div>
		</div>
		<!--fin div contenu-->
	</div>
	<!--fin div col-md-6-->
{% endblock %}
