{% extends 'base.html.twig' %}

{% block title %}Offre de volume
{% endblock %}

{% block body %}
	<div class="col-md-8 contenu-blanc ">

		<h1>
			{% if lesOffres | length == 0 %}
				Il n'y a pas d'offres de volume
			{% elseif lesOffres | length == 1%}
				L'offre de colume
			{% else %}
				Les
				<span>
					{{  lesOffres | length }}
				</span>
				offres de volume
			{% endif %}
		</h1>

		{{ include('messages.html.twig') }}

		<div class="contenu">
			<table class="table table-striped table-advance table-hover">
				<thead>
					<tr class="bg-entete">
						<th>Identifiant</th>
						<th>Produit</th>
						<th>Quantité</th>
						<th>Prix</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>

					{# Formulaire pour ajouter un nouvel offreVolume #}
					<tr>
						{{ form_start(formCreation)}}
						<td class="col-md-1">Nouveau</td>
						<td class="col-md-2">{{ form_widget(formCreation.Produits, { 'attr': {'class': 'col-md-12'} }) }}{{ form_errors(formCreation.Produits) }}</td>
						{#<td>{{ form_widget(formCreation.race) }}{{ form_errors(formCreation.race) }}</td> #}
						<td class="col-md-1">{{ form_widget(formCreation.qteVolume, { 'attr': {'class': 'col-md-12'} }) }}{{ form_errors(formCreation.qteVolume) }}</td>
						<td class="col-md-2">{{ form_widget(formCreation.prix, { 'attr': {'class': 'col-md-12'} }) }}{{ form_errors(formCreation.prix) }}</td>
						<td class="col-md-2">
							<button class="btn btn-primary btn-sm" type="submit" formaction="{{ path('app_offreVolume_ajouter') }}" title="Enregistrer nouvel offreVolume" onclick="windows.location.reload()">
								<i class="fa fa-save"></i>
								Enregistrer
							</button>
							<button class="btn btn-info btn-sm" type="reset" title="Effacer la saisie">
								<i class="fa fa-eraser"></i>
								Annuler
							</button>
						</td>
						{{ form_rest(formCreation) }}
						{{ form_end(formCreation)}}
					</tr>

					{# Liste des animaux existants #}
					{% for key, offreVolume in lesOffres %}
						<tr>
							{% if offreVolume.id != idOffreVolumeModif %}
								<td>{{ offreVolume.id }}</td>
								<td>{{ offreVolume.Produit }}</td>
								<td>{{ offreVolume.qteVolume }}</td>
								<td>{{ offreVolume.prix }}</td>
								<td>
									<form>
										<input type="hidden" name="page" value="{{ app.request.query.get('page', 1) }}">

										<button type="submit" class="btn btn-primary btn-sm" formaction="{{ path('app_offreVolume_demandermodification', {'id' : offreVolume.id }) }}" title="Modifier" onclick="windows.location.reload()">
											<i class="fa fa-pencil"></i>
											Modifier
										</button>

										<button class="btn btn-danger btn-sm" type="submit" formaction="{{ path('app_offreVolume_supprimer', {'id' : offreVolume.id }) }}" title="Supprimer" onclick="return confirm('Voulez-vous vraiment supprimer cette catégorie ?');">
											<i class="fa fa-trash-o "></i>
											Supprimer
										</button>
										<input
										type="hidden" name="_token" value="{{ csrf_token('action-item' ~ offreVolume.id) }}">
									{#  ~     pour concaténer des chaines en twig #}
									</form>
								</td>
							{% else %}

								<!-- formulaire pour modifier un offreVolume -->
								{{ form_start(formModification) }}
								<td>{{ offreVolume.id }}</td>
								<td>{{ form_widget(formModification.Produit, { 'attr': {'class': 'col-md-12'} }) }}
									{{ form_errors(formModification.Produit) }}</td>
								<td>{{ form_widget(formModification.qteVolume, { 'attr': {'class': 'col-md-12'} }) }}
									{{ form_errors(formModification.qteVolume) }}</td>
								<td>{{ form_widget(formModification.prix, { 'attr': {'class': 'col-md-12'} }) }}
									{{ form_errors(formModification.prix) }}</td>

								<td class="col-md-4">
									<button class="btn btn-primary btn-sm" type="submit" formaction="{{ path('app_offreVolume_modifier', { 'id' : offreVolume.id, 'page': app.request.query.get('page', 1) }) }}" title="Enregistrer" onclick="windows.location.reload()">
										<i class="fa fa-save"></i>
										Enregistrer
									</button>
									<button class="btn btn-info btn-sm" type="reset" title="Effacer la saisie">
										<i class="fa fa-eraser"></i>
										Effacer</button>
									<button class="btn btn-warning btn-sm" type="button" title="Annuler" onclick="windows.location.reload()">
										<a href="{{ path('app_offreVolume', {'page': app.request.query.get('page', 1)}) }}">
											<i class="fa fa-undo"></i>
											Annuler
										</a>
									</button>
								</td>
								{# Ceci va générer le champ CSRF #}
								{{ form_rest(formModification) }}
								{{ form_end(formModification) }}
							{% endif %}
						</tr>
					{% endfor %}

				</tbody>
			</table>
			<div class="navigation">
				{{ knp_pagination_render(lesOffres) }}
			</div>
		</div>
		<!-- fin div contenu -->
	</div>
	<!-- fin div col-md-10 -->
{% endblock %}
