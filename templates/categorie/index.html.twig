{% extends 'base.html.twig' %}

{% block title %}Catégories
{% endblock %}

{% block body %}
	{# pour passer les query params à la pagination pour les conserver lors du changement de page #}
	{% set query = app.request.query.all() %}

	<div class="col-md-7 contenu-blanc">

		<h1>
			{% if lesCategories | length == 0 %}
				Il n'y a pas de catégorie
			{% elseif lesCategories | length == 1%}
				La catégorie
			{% else %}
				Les
				<span>
					{{  lesCategories | length }}
				</span>
				catégories
			{% endif %}
		</h1>
		{{ include('messages.html.twig') }}
		<div class="contenu">
			<table class="table table-striped table-advance table-hover">
				<thead>
					<tr class="bg-entete">
						<th>Identifiant</th>
						<th>Libellé</th>
						<th>Image</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					<!-- formulaire pour ajouter une nouvelle catégorie-->
					<tr>
						{{ form_start(formCreation) }}
						<td class="col-md-1">Nouveau</td>
						<td class="col-md-3">{{ form_widget(formCreation.libelle, {'attr': {'class': 'col-md-12'}}) }}
							{{ form_errors(formCreation.libelle) }}</td>
						<td class="col-md-2">{{ form_widget(formCreation.imageFichier) }}
							{{ form_errors(formCreation.imageFichier) }}
						</td>
						<td class="col-md-2">
							<button class="btn btn-primary btn-sm" type="submit" formaction="{{ path('app_categorie_ajouter', query) }}" title="Enregistrer nouvelle catégorie" onclick="windows.location.reload()">
								<i class="fa fa-save"></i>
								Enregistrer</button>
							<button class="btn btn-info btn-sm" type="reset" title="Effacer la saisie" onclick="windows.location.reload()">
								<i class="fa fa-eraser"></i>
								Annuler
							</button>
						</td>
						{# Ceci va générer le champ CSRF #}
						{{ form_rest(formCreation) }}
						{{ form_end(formCreation) }}
					</tr>
					{% for key, categorie in lesCategories %}
						<tr>
							{% if categorie.id != idCategorieModif %}

								<td>{{ categorie.id }}</td>
								<td>{{ categorie.libelle }}</td>
								<td><img class="img-thumbnail img-fluid" src="{{ vich_uploader_asset(categorie, 'imageFichier') }}"/></td>
								<!-- formulaire pour demander la modification ou la suppression -->
								<td>
									<form method="get">
										{# c'est GET par défaut, on le précise simplement pour plus de clarté #}
										{# ajout de tous les paramètres de la query string actuelle pour les conserver lors de la demande de modification ou de suppression #}
											{% for key, value in app.request.query.all %}
												{% if value is iterable %}
													{% for subKey, subValue in value %}
												<input type="hidden" name="{{ key }}[{{ subKey }}]" value="{{ subValue }}"> {% endfor %}
											{% else %}
												<input type="hidden" name="{{ key }}" value="{{ value }}">
											{% endif %}
										{% endfor %}

										<input type="hidden" name="page" value="{{ app.request.query.get('page', 1) }}">

										<button type="submit" class="btn btn-primary btn-sm" formaction="{{ path('app_categorie_demandermodification', {'id' : categorie.id }) }}" title="Modifier" onclick="windows.location.reload()">
											<i class="fa fa-pencil"></i>
											Modifier
										</button>

										<button class="btn btn-danger btn-sm" type="submit" formaction="{{ path('app_categorie_supprimer', {'id' : categorie.id }) }}" title="Supprimer" onclick="return confirm('Voulez-vous vraiment supprimer cette catégorie ?');">
											<i class="fa fa-trash-o "></i>
											Supprimer
										</button>

										<input type="hidden" name="_token" value="{{ csrf_token('action-item' ~ categorie.id) }}">
									</form>
								</td>

							{% else %}

								<!-- formulaire pour modifier une catégorie -->
								{{ form_start(formModification) }}
								<td>{{ categorie.id }}</td>
								<td>{{ form_widget(formModification.libelle, {'attr': {'class': 'col-md-12'}}) }}
									{{ form_errors(formModification.libelle) }}</td>
								<td class="col-md-1">{{ form_widget(formModification.imageFichier) }}
									{{ form_errors(formModification.imageFichier) }}
								</td>

								<td class="col-md-4">
									<button class="btn btn-primary btn-sm" type="submit" formaction="{{ path('app_categorie_modifier', query|merge({'id': categorie.id})) }}" title="Enregistrer">
										<i class="fa fa-save"></i>
										Enregistrer
									</button>
									<button class="btn btn-info btn-sm" type="reset" title="Effacer la saisie">
										<i class="fa fa-eraser"></i>
										Effacer</button>
									<a class="btn btn-warning btn-sm" href="{{ path('app_categorie', query) }}" title="Annuler la modification">
										<i class="fa fa-undo"></i>
										Annuler
									</a>
								</td>
								{# Ceci va générer le champ CSRF #}
								{{ form_rest(formModification) }}
								{{ form_end(formModification) }}
							{% endif %}

						</tr>
					{% endfor %}

				</tbody>
			</table>
			<div class="navigation">
				{{ knp_pagination_render(lesCategories) }}
			</div>
		</div>
		<!--fin div contenu-->
	</div>
	<!--fin div col-md-6-->
{% endblock %}
