{% extends 'base.html.twig' %}

{% block title %}Statistiques produits par catégories
{% endblock %}

{% block body %}
    <div class="col-md-6 contenu-blanc">
        <h1>
            {% set total = lesCategoriesStats|length %}
            {{ total == 0 ? "Il n'y a pas de catégorie" : (total == 1 ? "La catégorie" : "Les " ~ total ~ " catégories") }}
        </h1>

        <div class="table-responsive contenu">
            <table class=" table table-striped table-advanced table-hover">
                <thead class="bg-entete">
                    <tr>
                        <th>Libellé</th>
                        <th>Produits</th>
                        <th>Prix Minimum</th>
                        <th>Prix Maximum</th>
                        <th>Prix Moyen</th>
                    </tr>
                </thead>
                <tbody>

                    {% for categorie in lesCategoriesStats %}
                        <tr>
                            <td>{{ categorie.libelle }}</td>
                            <td>{{ categorie.nbProduits }}</td>
                            <td>{{ categorie.prixMin|number_format(2, ',', ' ') }}
                                €</td>
                            <td>{{ categorie.prixMax|number_format(2, ',', ' ') }}
                                €</td>
                            <td>{{ categorie.prixMoyen|number_format(2, ',', ' ') }}
                                €</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">Aucune catégorie</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
